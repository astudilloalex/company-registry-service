{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company-registry.internal/contracts/events/company.site.updated.v1.schema.json",
  "title": "company.site.updated.v1",
  "description": "Immutable accepted fact. Producer additionally enforces payload.siteId=aggregateId, payload.updatedAt=occurredAt and eventId distinct from aggregateId. At least once future delivery, no global order guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "eventType",
    "eventSchemaVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "aggregateType": {
      "const": "COMPANY_SITE"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "eventType": {
      "const": "company.site.updated.v1"
    },
    "eventSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "causationId": {
      "type": "null"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId",
        "companyId",
        "code",
        "name",
        "siteType",
        "status",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "siteId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "companyId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "siteType": {
          "enum": [
            "HEADQUARTERS",
            "BRANCH",
            "WAREHOUSE",
            "OTHER"
          ]
        },
        "status": {
          "enum": [
            "DRAFT",
            "ACTIVE",
            "INACTIVE"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
