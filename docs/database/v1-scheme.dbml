// Source: src/main/resources/db/migration/V1__create_company_registry_schema.sql
// Flyway V1 is immutable. PostgreSQL 18 is authoritative for CHECKs and triggers.
Project company_registry {
  database_type: 'PostgreSQL'
  Note: 'Six application tables; flyway_schema_history is managed separately. Named CHECKs, trigger protections and partial-index predicates are inventoried in constraint-verification.md. External Party/geographic references have no database FK.'
}

Enum company_record_status {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}
Enum company_site_status {
  DRAFT
  ACTIVE
  INACTIVE
  CLOSED
}
Enum company_site_type {
  HEADQUARTERS
  BRANCH
  WAREHOUSE
  OTHER
}
Enum company_site_address_type {
  PHYSICAL
  MAILING
}
Enum company_site_contact_type {
  EMAIL
  PHONE
  MOBILE
  WHATSAPP
}
Enum company_outbox_aggregate_type {
  COMPANY
  COMPANY_SITE
}
Enum outbox_status {
  PENDING
  PUBLISHED
  FAILED
}

Table companies {
  id uuid [not null, default: `uuidv7()`]
  tenant_id uuid [not null]
  party_id uuid [not null, note: 'Opaque Party Registry identity; unique within tenant even when archived.']
  code varchar(64) [not null]
  operating_name varchar(200) [not null]
  description varchar(500)
  logo_url varchar(1000) [note: 'Case-sensitive opaque URL.']
  status company_record_status [not null, default: 'DRAFT']
  version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by varchar(128) [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by varchar(128) [not null]
  indexes {
    id [pk, name: 'pk_companies']
    (tenant_id, id) [unique, name: 'uq_companies_tenant_id']
    (tenant_id, party_id) [unique, name: 'uq_companies_tenant_party']
    (tenant_id, code) [unique, name: 'uq_companies_tenant_code']
    (tenant_id, status, id) [name: 'ix_companies_tenant_status']
    (tenant_id, created_at, id) [name: 'ix_companies_tenant_created', note: 'created_at DESC, id DESC']
  }
  Note: 'Canonical uppercase code/name/description; nonblank actors; version >= 0; updated_at >= created_at. trg_companies_immutable_changes protects id, tenant_id, party_id, created_at/by; ARCHIVED permits only identical updates. See inventory for exact named CHECKs.'
}

Table company_sites {
  id uuid [not null, default: `uuidv7()`]
  tenant_id uuid [not null]
  company_id uuid [not null]
  code varchar(64) [not null]
  name varchar(200) [not null]
  site_type company_site_type [not null, default: 'BRANCH']
  status company_site_status [not null, default: 'DRAFT']
  version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  created_by varchar(128) [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by varchar(128) [not null]
  indexes {
    id [pk, name: 'pk_company_sites']
    (tenant_id, company_id, id) [unique, name: 'uq_company_sites_owner_id']
    (company_id, code) [unique, name: 'uq_company_sites_code']
    company_id [unique, name: 'uq_company_sites_open_headquarters', note: "PARTIAL: site_type = 'HEADQUARTERS' AND status <> 'CLOSED'; not unconditional uniqueness."]
    (tenant_id, company_id, status, id) [name: 'ix_company_sites_tenant_status']
    (company_id, site_type) [name: 'ix_company_sites_type']
  }
  Note: 'Canonical code/name; version >= 0 and coherent audit. trg_company_sites_immutable_changes protects id, tenant_id, company_id, created_at/by; CLOSED permits only identical updates. Version shared with address/contact mutations.'
}

Table company_site_addresses {
  id uuid [not null, default: `uuidv7()`]
  site_id uuid [not null]
  address_type company_site_address_type [not null, default: 'PHYSICAL']
  country_code char(2) [not null]
  administrative_division_code varchar(64)
  address_line_1 varchar(300) [not null]
  address_line_2 varchar(300)
  house_number varchar(32)
  postal_code varchar(32)
  latitude numeric(9,6)
  longitude numeric(9,6)
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  created_by varchar(128) [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by varchar(128) [not null]
  deleted_at timestamptz
  deleted_by varchar(128)
  indexes {
    id [pk, name: 'pk_company_site_addresses']
    (site_id, address_type) [unique, name: 'uq_company_site_primary_address', note: 'PARTIAL: is_primary = true AND deleted_at IS NULL']
    (site_id, address_type) [name: 'ix_company_site_addresses_current', note: 'PARTIAL: deleted_at IS NULL']
  }
  Note: 'Country ^[A-Z]{2}$; business text canonical uppercase. Coordinates both NULL or both supplied, latitude [-90,90], longitude [-180,180]. Deletion requires timestamp >= creation, nonblank actor and is_primary=false. trg_company_site_addresses_immutable protects id/site_id/created_at/by. Tenant and Company queries must join Site.'
}

Table company_site_contact_points {
  id uuid [not null, default: `uuidv7()`]
  site_id uuid [not null]
  contact_type company_site_contact_type [not null]
  value varchar(320) [not null]
  label varchar(80)
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  created_by varchar(128) [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by varchar(128) [not null]
  deleted_at timestamptz
  deleted_by varchar(128)
  indexes {
    id [pk, name: 'pk_company_site_contact_points']
    (site_id, contact_type, value) [unique, name: 'uq_company_site_contacts_current_value', note: 'PARTIAL: deleted_at IS NULL; exact case-sensitive comparison']
    (site_id, contact_type) [unique, name: 'uq_company_site_primary_contact', note: 'PARTIAL: is_primary = true AND deleted_at IS NULL']
  }
  Note: 'Trimmed nonblank value; EMAIL case preserved, other types match ^[+][1-9][0-9]{1,14}$. Label canonical uppercase. Coherent audit/deletion as Address. trg_company_site_contacts_immutable protects id/site_id/created_at/by. Tenant/Company scope via Site.'
}

Table company_idempotency_records {
  tenant_id uuid [not null]
  operation varchar(64) [not null]
  idempotency_key varchar(128) [not null]
  request_hash char(64) [not null, note: 'Lowercase hexadecimal HMAC fingerprint.']
  company_id uuid [not null]
  site_id uuid
  expected_aggregate_version bigint
  response_http_status smallint [not null]
  result_snapshot_schema_version smallint [not null, default: 1]
  result_snapshot jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  created_by varchar(128) [not null]
  indexes {
    (tenant_id, operation, idempotency_key) [pk, name: 'pk_company_idempotency_records']
    (tenant_id, company_id, site_id) [name: 'ix_company_idempotency_owner']
  }
  Note: 'Nonblank operation/key/actor; hash ^[0-9a-f]{64}$; expected version NULL or >=0; HTTP 200..299; snapshot version >0 and JSON object. Nullable site_id allows Company-only completion (default FK MATCH SIMPLE). Snapshot is original response, not current aggregate state.'
}

Table company_outbox_events {
  id uuid [not null, default: `uuidv7()`]
  tenant_id uuid [not null]
  aggregate_type company_outbox_aggregate_type [not null]
  aggregate_id uuid [not null, note: 'Polymorphic logical reference; no FK.']
  aggregate_version bigint [not null]
  event_type varchar(128) [not null]
  event_schema_version smallint [not null, default: 1]
  payload jsonb [not null]
  occurred_at timestamptz [not null, default: `now()`]
  correlation_id varchar(128) [not null]
  causation_id varchar(128)
  status outbox_status [not null, default: 'PENDING']
  publish_attempts integer [not null, default: 0]
  next_attempt_at timestamptz
  last_attempt_at timestamptz
  published_at timestamptz
  last_error_code varchar(64)
  last_error_detail varchar(1000)
  created_at timestamptz [not null, default: `now()`]
  created_by varchar(128) [not null]
  updated_at timestamptz [not null, default: `now()`]
  updated_by varchar(128) [not null]
  version bigint [not null, default: 0, note: 'Technical optimistic version, distinct from aggregate_version.']
  indexes {
    id [pk, name: 'pk_company_outbox_events']
    (tenant_id, aggregate_type, aggregate_id, aggregate_version, event_type) [unique, name: 'uq_company_outbox_event_identity']
    (status, next_attempt_at, created_at, id) [name: 'ix_company_outbox_delivery']
    correlation_id [name: 'ix_company_outbox_correlation']
  }
  Note: 'Allowed COMPANY events: company.{created,updated,activated,deactivated}.v1; COMPANY_SITE: company.site.{created,updated,closed}.v1. Creation version=0, others>0; schema>0; JSON object; nonblank correlation/optional causation; attempts/version>=0; published_at iff PUBLISHED; FAILED requires nonblank error code; coherent audit. No publisher implemented by V1.'
}

Ref fk_company_sites_company: company_sites.(tenant_id, company_id) > companies.(tenant_id, id) [delete: restrict]
Ref fk_company_site_addresses_site: company_site_addresses.site_id > company_sites.id [delete: restrict]
Ref fk_company_site_contacts_site: company_site_contact_points.site_id > company_sites.id [delete: restrict]
Ref fk_company_idempotency_company: company_idempotency_records.(tenant_id, company_id) > companies.(tenant_id, id) [delete: restrict]
Ref fk_company_idempotency_site: company_idempotency_records.(tenant_id, company_id, site_id) > company_sites.(tenant_id, company_id, id) [delete: restrict]
