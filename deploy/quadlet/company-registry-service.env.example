# Render through deploy/vps/render-env.py; never source this file in a shell.
# Destination: /home/containers/deployment/env/company-registry-service.env (0600).
QUARKUS_PROFILE=prod
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8083
QUARKUS_CONFIG_LOCATIONS=file:/run/secrets/company-keys.properties

DB_USERNAME=company_registry_runtime
DB_PASSWORD=REPLACE_WITH_RUNTIME_DATABASE_PASSWORD
DB_REACTIVE_URL=postgresql://postgresql:5432/company_registry_service
DB_JDBC_URL=jdbc:postgresql://postgresql:5432/company_registry_service
FLYWAY_DB_USERNAME=company_registry_migration
FLYWAY_DB_PASSWORD=REPLACE_WITH_MIGRATION_DATABASE_PASSWORD
POSTGRES_CONTAINER=postgresql
QUARKUS_DATASOURCE_REACTIVE_MAX_SIZE=20

PARTY_REGISTRY_BASE_URL=http://party-registry-service:8080
GEOGRAPHIC_REFERENCE_BASE_URL=http://geographic-reference-service:8080
PARTY_REGISTRY_CONNECT_TIMEOUT_MS=2500
PARTY_REGISTRY_READ_TIMEOUT_MS=5000
GEOGRAPHIC_REFERENCE_CONNECT_TIMEOUT_MS=2000
GEOGRAPHIC_REFERENCE_READ_TIMEOUT_MS=5000

# Supply COMPANY_IDEMPOTENCY_KEYS_JSON separately to the renderer, including
# every historical key. It is written only to the protected properties file.
COMPANY_IDEMPOTENCY_ACTIVE_KEY_ID=K1

# Initial deployment: no RabbitMQ credentials or connectivity are required.
# All three Podman networks remain attached in every outbox mode.
COMPANY_OUTBOX_MODE=disabled
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=REPLACE_WITH_RABBITMQ_USERNAME
RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
RABBITMQ_VIRTUAL_HOST=platform
COMPANY_OUTBOX_EXCHANGE=company.events
COMPANY_OUTBOX_ROUTING_KEY=%s
COMPANY_OUTBOX_POLL_INTERVAL=5s
COMPANY_OUTBOX_BATCH_SIZE=25
COMPANY_OUTBOX_PUBLISH_TIMEOUT=5s
COMPANY_OUTBOX_CLAIM_LEASE=30s
COMPANY_OUTBOX_INITIAL_BACKOFF=1s
COMPANY_OUTBOX_MAXIMUM_BACKOFF=5m
COMPANY_OUTBOX_MAXIMUM_ATTEMPTS=10

# Non-secret deployment limits, rendered into systemd's resource restrictions.
# CPU quota is relative to one CPU; 50% allows at most half a CPU of time.
COMPANY_MEMORY_MAX=256M
COMPANY_CPU_QUOTA=50%
COMPANY_PIDS_LIMIT=128
