####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode.
#
# Before building the container image run:
#
# Build the production variant with the native flags and resource limits in
# docs/operations/native-verification.md (omit -Pverification=true).
#
# Then, build the image with:
#
# podman build -f src/main/docker/Dockerfile.native -t company-registry-service:native .
#
# Then run the container using:
#
# Supply the separate runtime/Flyway database variables documented in README.
# podman run --rm -p 127.0.0.1:8083:8083 --env-file <external-config> company-registry-service:native
#
# Runtime: UBI 9 Minimal, direct native executable, non-privileged user 1001.
###
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 build/*-runner /work/application

EXPOSE 8083
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
